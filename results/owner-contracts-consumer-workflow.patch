--- a/.github/workflows/research-environment-image.yml
+++ b/.github/workflows/research-environment-image.yml
@@ -405,8 +405,34 @@
           COMPARE
           done
           exit "${status}"
 
+      # lattice-database's owner contracts, run inside the image against the image's own
+      # sage_extensions and sage_julia_bridge -- no PYTHONPATH binding to a checkout, so
+      # what is observed is the published pair. The A2 contract
+      # (test_positive_a2_genus_and_orthogonal_group_are_owned_by_the_lattice) times out
+      # at 60 s on a GitHub runner inside the Julia bridge's stderr drain
+      # (sage_julia_bridge/interface.py:279); sage-extensions#300 is that defect and its
+      # acceptance is this module returning here.
+      - name: Run lattice-database's owner contracts against the image's packages
+        run: |
+          set -uo pipefail
+          checkout=/repos/lattice-database
+          git -C "${checkout}" rev-parse HEAD
+          module="${checkout}/tests/lattices/test_lattice_database_owner_contracts.sage"
+          test -f "${module}"
+          /sage/.venv/bin/python -c 'import sage_extensions, sage_julia_bridge; print(sage_extensions.__file__); print(sage_julia_bridge.__file__)'
+          set +e
+          timeout 1500 /sage/.venv/bin/python -m pytest -o addopts= \
+            --durations=0 -q -p qc_sage_session "${module}"
+          status=$?
+          set -e
+          if [ "${status}" -eq 124 ]; then
+            echo "the owner contracts did not finish within 1500 s"
+          fi
+          echo "owner contracts exited ${status}"
+          exit "${status}"
+
       - name: Upload the reproduced record outputs
         if: always()
         uses: actions/upload-artifact@v4
         with:
