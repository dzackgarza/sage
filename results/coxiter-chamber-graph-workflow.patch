diff --git a/.github/workflows/research-environment-image.yml b/.github/workflows/research-environment-image.yml
index decc35bd4d0..8b0730651f5 100644
--- a/.github/workflows/research-environment-image.yml
+++ b/.github/workflows/research-environment-image.yml
@@ -674,14 +674,37 @@ jobs:
         test -f "${record}"
         coxiter="$(command -v coxiter)"
         echo "coxiter: ${coxiter}"
-        "${coxiter}" -h > /tmp/coxiter-usage.txt 2>&1 || true
-        head -20 /tmp/coxiter-usage.txt
-        set +e
-        "${coxiter}" -v < "${record}" > /tmp/coxiter-I18.out 2>&1
-        status=$?
-        set -e
-        echo "coxiter exited ${status}"
+        # CoxIter reads a graph file: a vertex count on the first line, then `<a> <b> <order>`
+        # per edge. The record states its chamber in prose and in a #-commented Gram matrix, so
+        # feeding the record itself handed CoxIter the 8 in "initial roots: 8" as a vertex count
+        # and produced an eight-vertex simplex with Euler characteristic 1/256 in run 42362483952
+        # -- exit 0, and no reading of the chamber at all. The graph is derived here from the two
+        # lines of that record which do state it: "walls: 9" and the edge list beside it.
+        graph="$(mktemp)"
+        /sage/.venv/bin/python - "${record}" "${graph}" <<'GRAPH'
+        import ast
+        import re
+        import sys
+
+        record, destination = sys.argv[1:3]
+        text = open(record, encoding="utf-8").read()
+        walls = re.search(r"^\s*walls:\s*(\d+)", text, re.M)
+        edges = re.search(r"^\s*edges \(i, j, label\):\s*(\[.*\])", text, re.M)
+        assert walls and edges, "the record states no chamber graph"
+        rows = [walls.group(1)] + ["%d %d %d" % tuple(edge) for edge in ast.literal_eval(edges.group(1))]
+        open(destination, "w", encoding="utf-8").write("\n".join(rows) + "\n")
+        GRAPH
+        echo "--- the graph handed to CoxIter"
+        cat "${graph}"
+        "${coxiter}" -v < "${graph}" > /tmp/coxiter-I18.out 2>&1
+        echo "coxiter exited $?"
         cat /tmp/coxiter-I18.out
+        # Acceptance is the reading, not the exit status: the graph read must be the nine-wall
+        # chamber this record states. CoxIter's verdict on it stays evidence, not a gate.
+        grep -q "Number of vertices: 9" /tmp/coxiter-I18.out
+        grep -q "Guessed dimension: 8" /tmp/coxiter-I18.out
+        grep -q "Field generated by the entries of the Gram matrix: Q[sqrt(2)]" /tmp/coxiter-I18.out
+        echo "CoxIter read the nine-wall chamber of ${record}"
 
     - name: Upload the reproduced record outputs
       if: always()
