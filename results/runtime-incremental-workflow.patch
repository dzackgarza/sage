+            fi
+            printf '%s\n' "$runtime_output" >&2
+            echo "Registry lookup failed; refusing to build the runtime image on an unproven base" >&2
+            exit 1
+          fi
+          echo "kind=incremental" >> "$GITHUB_OUTPUT"
+          echo "runtime_base=$runtime_image" >> "$GITHUB_OUTPUT"
