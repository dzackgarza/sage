--- a/.github/workflows/research-environment-image.yml
+++ b/.github/workflows/research-environment-image.yml
@@ -174,10 +174,16 @@
           changes="$(git -C sage-source diff --name-status "$base_revision" HEAD)"
           printf 'Changes since the base image (%s):\n%s\n' "$base_revision" "$changes"
           if grep -qE '^D|docker/research-environment\.Dockerfile$' <<<"$changes"; then
             echo "kind=full" >> "$GITHUB_OUTPUT"
+            # The runtime tag comes from the main Dockerfile's runtime stage.
+            echo "runtime_base=$BASE_IMAGE" >> "$GITHUB_OUTPUT"
           else
             echo "kind=incremental" >> "$GITHUB_OUTPUT"
+            # ...and from the previous runtime image on a source-only push, where the
+            # main Dockerfile's `COPY . /sage` would miss and the Sage compile below
+            # it would run from scratch on every push (sage#9).
+            echo "runtime_base=ghcr.io/${GITHUB_REPOSITORY_OWNER}/sage:runtime-$base_revision" >> "$GITHUB_OUTPUT"
           fi
       - name: Build and publish the selected Sage image
         if: steps.image-tag.outputs.exists != 'true'
         uses: docker/build-push-action@v6
@@ -203,12 +209,12 @@
         if: steps.image-tag.outputs.exists != 'true'
         uses: docker/build-push-action@v6
         with:
           context: sage-source
-          file: sage-source/docker/research-environment.Dockerfile
+          file: sage-source/docker/${{ steps.build-kind.outputs.kind == 'incremental' && 'research-environment-runtime-incremental.Dockerfile' || 'research-environment.Dockerfile' }}
           target: runtime
           build-args: |
-            BASE_IMAGE=ghcr.io/${{ github.repository_owner }}/sage:develop
+            BASE_IMAGE=${{ steps.build-kind.outputs.runtime_base }}
             RELOCK=${{ inputs.relock && 'true' || 'false' }}
           push: true
           tags: ${{ steps.image-tag.outputs.runtime_tags }}
           labels: org.opencontainers.image.revision=${{ inputs.sage_source_sha || github.sha }}
