+          # The incremental runtime build derives from the runtime tag of exactly the
+          # image it is rebuilding, so that tag has to exist. A run whose runtime step
+          # failed publishes :develop and no runtime-<sha>; without this the next
+          # source push would derive from a tag that is not there and die inside the
+          # build on a pull. Proven absence names the repair; an unreadable registry
+          # refuses to guess.
+          set +e
+          runtime_output="$(docker manifest inspect "$runtime_image" 2>&1)"
+          runtime_status=$?
