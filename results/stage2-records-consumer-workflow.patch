+      # The same record's chamber read by the other engine: CoxIter on the nine-node
+      # diagram the Vinberg run prints. The in-tree row for (9, 9, 1) calls that diagram
+      # a chain, which is the claim this log lets the research chat check. It prints and
+      # does not gate: CoxIter's verdict on the diagram is evidence, not an image defect.
+      - name: Read the I_{1,8} chamber with CoxIter
+        run: |
+          set -uo pipefail
+          record=/repos/research/computations/reports/coble_I18_vinberg-chamber-run.txt
+          test -f "${record}"
+          coxiter="$(command -v coxiter)"
+          echo "coxiter: ${coxiter}"
+          "${coxiter}" -h > /tmp/coxiter-usage.txt 2>&1 || true
+          head -20 /tmp/coxiter-usage.txt
+          set +e
+          "${coxiter}" -v < "${record}" > /tmp/coxiter-I18.out 2>&1
+          status=$?
+          set -e
+          echo "coxiter exited ${status}"
+          cat /tmp/coxiter-I18.out
+
       - name: Upload the reproduced record outputs
