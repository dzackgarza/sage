--- a/.github/workflows/research-environment-image.yml
+++ b/.github/workflows/research-environment-image.yml
@@ -350,8 +350,73 @@
           name: latticedb-certificates-6JRR
           path: /repos/lattice-database/certificates/
           if-no-files-found: warn
 
+      # The stage-1 research records, reproduced inside the image. Each record is a
+      # script beside the `-run.txt` it produced; that file opens with the block the
+      # script prints first, its provenance (provider pin, source roots, Sage version,
+      # image rootfs, the sage_extensions path), and that block describes the machine
+      # rather than the mathematics. The comparison drops it -- the lines from the
+      # opening `provenance` to the first blank line -- and holds every non-blank line
+      # after it, right-trimmed, to the committed file. A differing result line fails
+      # the job and prints the diff.
+      - name: Reproduce the stage-1 research records
+        run: |
+          set -uo pipefail
+          checkout=/repos/research
+          git -C "${checkout}" rev-parse HEAD
+          status=0
+          for record in coble_isotropic_orbits coble_plane-half-f2; do
+            script="${checkout}/computations/reports/${record}.py"
+            expected="${checkout}/computations/reports/${record}-run.txt"
+            actual="/tmp/${record}.out"
+            test -f "${script}" && test -f "${expected}"
+            PYTHONPATH="/repos/research/src:${checkout}/src" \
+              /sage/.venv/bin/python "${script}" > "${actual}" 2>&1 || {
+                echo "${record}: the script exited non-zero; its output follows"
+                cat "${actual}"
+                status=1
+                continue
+              }
+            /sage/.venv/bin/python - "${expected}" "${actual}" "${record}" <<'COMPARE' || status=1
+          import difflib
+          import sys
+
+          expected_path, actual_path, name = sys.argv[1:4]
+
+
+          def results(path):
+              """The record's lines without the provenance block it prints first."""
+              lines = open(path, encoding="utf-8").read().splitlines()
+              if lines and lines[0].strip() == "provenance":
+                  while lines and lines[0].strip():
+                      lines.pop(0)
+                  while lines and not lines[0].strip():
+                      lines.pop(0)
+              return [line.rstrip() for line in lines if line.strip()]
+
+
+          want, got = results(expected_path), results(actual_path)
+          if want == got:
+              print(f"{name}: reproduced, {len(got)} result lines match")
+              raise SystemExit(0)
+          print(f"{name}: differs")
+          print("\n".join(difflib.unified_diff(want, got, "committed", "run here", lineterm="", n=2)))
+          raise SystemExit(1)
+          COMPARE
+          done
+          exit "${status}"
+
+      - name: Upload the reproduced record outputs
+        if: always()
+        uses: actions/upload-artifact@v4
+        with:
+          name: research-stage1-records
+          path: |
+            /tmp/coble_isotropic_orbits.out
+            /tmp/coble_plane-half-f2.out
+          if-no-files-found: warn
+
