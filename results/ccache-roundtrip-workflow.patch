--- a/.github/workflows/research-environment-image.yml
+++ b/.github/workflows/research-environment-image.yml
@@ -103,20 +103,28 @@
         run: |
           sudo rm -rf /usr/share/dotnet /usr/local/lib/android /opt/ghc /opt/hostedtoolcache/CodeQL
           df -h /
       - uses: docker/setup-buildx-action@v3
-      # The Dockerfile's ccache mount lives in BuildKit, which each runner
-      # starts empty; carry it through the Actions cache between runs.
+        id: setup-buildx
+      # The Dockerfile's ccache mount lives in BuildKit, which each runner starts
+      # empty; carry it through the Actions cache between runs. Restoring and
+      # injecting is half the round trip: cache-dance only writes into the builder,
+      # and the cache comes back to `ccache/` through a second invocation with
+      # `extract: true` after the builds. Without that step nothing ever writes the
+      # directory, so every run restored an empty cache.
       - name: Restore the Sage compiler cache
         uses: actions/cache@v4
+        id: ccache
         with:
           path: ccache
           key: sage-ccache-${{ github.sha }}
           restore-keys: sage-ccache-
       - name: Inject the compiler cache into BuildKit
         uses: reproducible-containers/buildkit-cache-dance@v3.4.0
         with:
+          builder: ${{ steps.setup-buildx.outputs.name }}
           cache-map: '{"ccache": "/ccache"}'
+          skip-extraction: ${{ steps.ccache.outputs.cache-hit == 'true' }}
       - uses: docker/login-action@v3
         with:
           registry: ghcr.io
           username: ${{ github.actor }}
@@ -187,8 +195,19 @@
           # Layers go to the registry: the Actions cache is capped at 10 GB
           # per repository, which a Sage image's layers exceed.
           cache-from: type=registry,ref=ghcr.io/${{ github.repository_owner }}/sage:buildcache
           cache-to: type=registry,ref=ghcr.io/${{ github.repository_owner }}/sage:buildcache,mode=max
+      # Back out of the builder into `ccache/`, which actions/cache saves at job end.
+      # It runs on failure too: a build that dies after compiling still warmed the
+      # cache, and that is what makes the next full build cheap.
+      - name: Extract the compiler cache from BuildKit
+        if: always()
+        uses: reproducible-containers/buildkit-cache-dance@v3.4.0
+        with:
+          builder: ${{ steps.setup-buildx.outputs.name }}
+          cache-map: '{"ccache": "/ccache"}'
+          extract: true
+
       # The lock stage reuses the build above from the BuildKit cache.
       - name: Export the lock the image was built on
         if: inputs.relock
         uses: docker/build-push-action@v6
