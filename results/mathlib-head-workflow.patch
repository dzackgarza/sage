diff --git a/.github/workflows/research-environment-image.yml b/.github/workflows/research-environment-image.yml
index 2e3f63f78a6..914b23ea8f6 100644
--- a/.github/workflows/research-environment-image.yml
+++ b/.github/workflows/research-environment-image.yml
@@ -183,6 +183,26 @@ jobs:
       # last published image. The full build runs when the system layers
       # changed, when a file was deleted (the incremental copy deletes
       # nothing), or for an isolated spinor image.
+    - name: Resolve the Mathlib head this build carries
+      id: mathlib
+      # Every build carries the head of mathlib4 master as it is when the build
+      # starts, incremental builds included (sage#13). Reading it here and passing it
+      # to the build makes it a build input: unchanged, the steps that provision the
+      # shared Lean project are a cache hit and their layer is reused; moved, they
+      # run and rebuild its closure.
+      run: |
+        set -eu
+        revision="$(git ls-remote https://github.com/leanprover-community/mathlib4 \
+            refs/heads/master | awk 'NR == 1 { print $1 }')"
+        case "$revision" in
+          *[!0-9a-f]* | '')
+            echo "mathlib4 master did not report a revision: '$revision'" >&2
+            exit 1
+            ;;
+        esac
+        test "${#revision}" -eq 40
+        echo "revision=$revision" >> "$GITHUB_OUTPUT"
+        echo "this build carries mathlib4 master at $revision"
     - name: Select a full or an incremental build
       id: build-kind
       if: steps.image-tag.outputs.exists != 'true'
@@ -244,13 +264,17 @@ jobs:
         build-args: |
           BASE_IMAGE=ghcr.io/${{ github.repository_owner }}/sage:develop
           RELOCK=${{ inputs.relock && 'true' || 'false' }}
+          MATHLIB_REVISION=${{ steps.mathlib.outputs.revision }}
         outputs: type=image,push=true,compression=zstd,compression-level=3,force-compression=true,oci-mediatypes=true
         tags: ghcr.io/${{ github.repository_owner }}/sage:${{ 
           steps.image-tag.outputs.tag }}
-        labels: org.opencontainers.image.revision=${{ inputs.sage_source_sha || 
-          github.sha }}
-          # Layers go to the registry: the Actions cache is capped at 10 GB
-          # per repository, which a Sage image's layers exceed.
+        # The image states the Mathlib revision it carries, so nobody has to pull it
+        # to find out, and the next build can compare its own resolution with it.
+        labels: |
+          org.opencontainers.image.revision=${{ inputs.sage_source_sha || github.sha }}
+          dev.dzackgarza.mathlib.revision=${{ steps.mathlib.outputs.revision }}
+        # Layers go to the registry: the Actions cache is capped at 10 GB per
+        # repository, which a Sage image's layers exceed.
         cache-from: type=registry,ref=ghcr.io/${{ github.repository_owner 
           }}/sage:buildcache
         cache-to: type=registry,ref=ghcr.io/${{ github.repository_owner 
@@ -279,6 +303,7 @@ jobs:
         build-args: |
           BASE_IMAGE=ghcr.io/${{ github.repository_owner }}/sage:develop
           RELOCK=true
+          MATHLIB_REVISION=${{ steps.mathlib.outputs.revision }}
         cache-from: type=registry,ref=ghcr.io/${{ github.repository_owner 
           }}/sage:buildcache
         outputs: type=local,dest=relock
