--- a/.github/workflows/research-environment-image.yml
+++ b/.github/workflows/research-environment-image.yml
@@ -336,9 +336,15 @@
       # Stage-1 acceptance is that the published counts reproduce inside the published
       # image, not on a PYTHONPATH binding to a working tree. The module is run from the
       # installed sage-extensions checkout, which is what the environment check asserts
       # is installed from /repos/sage-extensions.
+      # -p qc_sage_session imports a plugin the image does not install; the job already
+      # checks the collector out at .qc-infra and this is the path the four-spinor step
+      # uses. Without it pytest exits before collection:
+      # `ModuleNotFoundError: No module named 'qc_sage_session'` (run 42327313317).
       - name: Run sage-extensions' isotropic-line-orbit suite from the installed checkout
+        env:
+          PYTHONPATH: ${{ github.workspace }}/.qc-infra/scripts/pytest_plugins
         run: |
           set -eu
           checkout=/repos/sage-extensions
           test -d "${checkout}/tests/lattices"
@@ -504,9 +510,15 @@
       # (test_positive_a2_genus_and_orthogonal_group_are_owned_by_the_lattice) times out
       # at 60 s on a GitHub runner inside the Julia bridge's stderr drain
       # (sage_julia_bridge/interface.py:279); sage-extensions#300 is that defect and its
       # acceptance is this module returning here.
+      # -p qc_sage_session imports a plugin the image does not install; the job already
+      # checks the collector out at .qc-infra and this is the path the four-spinor step
+      # uses. Without it pytest exits before collection:
+      # `ModuleNotFoundError: No module named 'qc_sage_session'` (run 42327313317).
       - name: Run lattice-database's owner contracts against the image's packages
+        env:
+          PYTHONPATH: ${{ github.workspace }}/.qc-infra/scripts/pytest_plugins
         run: |
           set -uo pipefail
           checkout=/repos/lattice-database
           git -C "${checkout}" rev-parse HEAD
